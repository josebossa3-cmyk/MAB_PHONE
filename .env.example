# Environment
NODE_ENV=development

# Database Configuration
# Para PostgreSQL (recomendado para producción):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/stock_db

# Para desarrollo local con SQLite:
# DATABASE_URL=file:./prisma/dev.db

# Session & Security
# Genera una clave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=tu-clave-super-secreta-y-larga-aqui-cambiar-en-produccion

# JWT Configuration (opcional, si se implementa)
JWT_SECRET=tu-jwt-secret-aqui
JWT_EXPIRES_IN=24h

# Encryption
# Clave para encriptar sesiones
ENCRYPTION_KEY=cambiar-esta-clave-en-produccion

# Cookies
COOKIE_SECURE=false  # true en producción con HTTPS
COOKIE_SAME_SITE=lax

# API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database Credentials (para PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db
DB_USER=postgres
DB_PASSWORD=password

# Email Configuration (opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Logging
LOG_LEVEL=debug

# Security
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=false  # true en producción
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MS=900000  # 15 minutos
