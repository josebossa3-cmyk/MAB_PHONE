# Local Development Configuration
NODE_ENV=development

# Database URL para desarrollo local
# Descomenta una de las siguientes opciones:

# Opción 1: PostgreSQL local (si tienes PostgreSQL instalado)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/stock_db_dev

# Opción 2: SQLite local (más fácil para desarrollo)
# DATABASE_URL=file:./prisma/dev.db

# Session & Security
SESSION_SECRET=desarrollo-local-no-usar-en-produccion

# JWT
JWT_SECRET=desarrollo-local-secret
JWT_EXPIRES_IN=24h

# Encryption
ENCRYPTION_KEY=desarrollo-local-encription-key

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (si usas PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_db_dev
DB_USER=postgres
DB_PASSWORD=password

# Logging
LOG_LEVEL=debug

# Security
CSRF_ENABLED=false  # Puedes deshabilitarlo en desarrollo
RATE_LIMIT_ENABLED=false
